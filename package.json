{
  "name": "schulte-table",
  "version": "1.0.0",
  "description": "舒爾特方格：數字、注音、英文字母、圖案依序點完的專注力遊戲。五段難度、經典／逆序／隨機、闖關 50 關、每日挑戰，線上同盤搶點與同題競速、觀戰與邀請連結（零依賴）",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/rules.test.js tests/rooms.test.js && node tests/online-check.js",
    "test:rules": "node --test tests/rules.test.js",
    "test:online": "node tests/online-check.js",
    "build:glyphs": "node scripts/build-glyphs.cjs",
    "inject": "node scripts/inject-server-url.js",
    "inject:seo": "node scripts/inject-seo.js",
    "test:rooms": "node --test tests/rooms.test.js",
    "check:flow": "node scripts/flow-check.cjs",
    "check:rwd": "node scripts/rwd-audit.cjs",
    "check:failover": "node scripts/failover-check.cjs",
    "cf:build": "node cloudflare/build-worker.cjs",
    "cf:smoke": "node cloudflare/smoke.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED",
  "private": true
}
